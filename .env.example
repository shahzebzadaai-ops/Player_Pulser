# Local development only. Copy to .env. Never commit .env.
# Production uses config/production.json and config/secrets.production.json.
# Do not copy this file to the VPS.

DATABASE_URL=postgresql://playerpulser:playerpulser@127.0.0.1:5432/playerpulser
# Optional. Same database, separate pool for the worker process.
# Local development adds connection_limit=10 and pool_timeout=30 on the app,
# and connection_limit=5 and pool_timeout=30 on the worker, unless the URL already sets them.
# Production uses the URL exactly as written.
# WORKER_DATABASE_URL=postgresql://playerpulser:playerpulser@127.0.0.1:5432/playerpulser
REDIS_URL=redis://127.0.0.1:6379

# Required in production. At least 32 characters. Sessions are rejected without it.
AUTH_SECRET=replace-with-a-long-random-string

# Development login and the on-screen OTP exist only when both are true.
# NODE_ENV=production forces them off even if this flag is copied by mistake.
DEV_AUTH_ENABLED=true

# Investor demo. Leave unset to keep Try Live Demo available.
# Set to false and restart the web app to hide the button and reject new demo sessions.
# INVESTOR_DEMO_ENABLED=false
OTP_PROVIDER=simulated

# Simulated payments are the only provider wired up.
# Real charges stay off until a provider account is confirmed.
PAYMENT_PROVIDER=simulated
PAYMENT_WEBHOOK_SECRET=replace-with-a-webhook-secret
SIMULATED_PAYMENTS_AUTO_SETTLE=true
# Set true only for an explicit staging simulation. Production refuses the simulator otherwise.
ALLOW_SIMULATED_PAYMENTS=false

ADMIN_SEED_PASSWORD=dev-admin-1
DEMO_SEED=true
