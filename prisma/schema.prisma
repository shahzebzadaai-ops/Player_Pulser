  lastEventAt         DateTime? @db.Timestamptz(3)
  consecutiveFailures Int       @default(0)
  successCount        Int       @default(0)
  failureCount        Int       @default(0)
  latencyTotalMs      Int       @default(0)
  latencySamples      Int       @default(0)
